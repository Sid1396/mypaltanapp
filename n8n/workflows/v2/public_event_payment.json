        "jsCode": "const $in = $input.first().json;\nconst slug = String($in.query?.event ?? '').toLowerCase();\nif (!/^[a-z0-9-]{2,30}$/.test(slug)) return [{ json: { ok: false, status: 422, body: { success: false, message: 'Unknown event.' } } }];\nreturn [{ json: { ok: true, slug } }];"
