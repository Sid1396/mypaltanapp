    {
      "id": "f3629a38-4177-4966-b987-81561a5b113c",
      "name": "Sign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -100
      ],
      "parameters": {
        "jsCode": "\nconst b2 = $('Authorize B2').isExecuted ? $('Authorize B2').first().json : {};\nconst dl = b2?.apiInfo?.storageApi?.downloadUrl;\nconst tokenOf = node => { try { return $(node).isExecuted ? $(node).first().json.authorizationToken : null; } catch { return null; } };\nconst signWith = (key, node) => { const t = tokenOf(node); return key && dl && t ? `${dl}/file/mypaltan-profile-photos/${key.split('/').map(encodeURIComponent).join('/')}?Authorization=${t}` : null; };\nconst parseJ = v => { if (v === null || v === undefined) return null; if (typeof v === 'object') return v; try { return JSON.parse(v); } catch { return null; } };\n\nconst row = $('Load Settings').first().json, slug = $('Check Request').first().json.slug;\nconst url = signWith(row.qr_key, 'QR Link');\nif (!url) return [{ json: { status: 200, body: { success: true, payment: null } } }];\nconst store = $getWorkflowStaticData('global');\nstore.qr = { ...(store.qr || {}), [slug]: { key: row.qr_key, url, exp: Date.now() + 20 * 3600e3 } };\nreturn [{ json: { status: 200, body: { success: true, payment: { upi_id: row.upi_id, upi_name: row.upi_name, qr_url: url } } } }];"
      }
    },
