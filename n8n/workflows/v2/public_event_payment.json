      ],
      "parameters": {
        "jsCode": "const $in = $input.first().json;\n\nconst row = $in, slug = $('Check Request').first().json.slug;\n// No row: the website keeps its built-in payment details.\nif (!row.qr_key) return [{ json: { done: true, status: 200, body: { success: true, payment: null } } }];\nconst cached = ($getWorkflowStaticData('global').qr || {})[slug];\nif (cached && cached.key === row.qr_key && cached.exp > Date.now())\n  return [{ json: { done: true, status: 200, body: { success: true, payment: { upi_id: row.upi_id, upi_name: row.upi_name, qr_url: cached.url } } } }];\nreturn [{ json: { done: false } }];"
      }
