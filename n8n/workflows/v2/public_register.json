      "id": "db27e212-8665-4a85-a806-52458aadf9a9",
      "name": "Check Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const $in = $input.first().json;\nconst byteSize = async (key, f) => {\n  try { const buf = await this.helpers.getBinaryDataBuffer(0, key); if (buf && buf.length) return buf.length; } catch (e) {}\n  const m = String(f.fileSize ?? '').trim().match(/^([\\d.]+)\\s*(B|kB|KB|MB|GB)?$/i);\n  if (m) return Math.ceil(parseFloat(m[1]) * ({ b: 1, kb: 1000, mb: 1e6, gb: 1e9 })[(m[2] || 'B').toLowerCase()]);\n  return Buffer.from(f.data || '', 'base64').length;\n};\n\nconst EVENTS = {\"sspl\": {\"name\": \"SSPL 2027 Season 07\", \"closes\": \"2026-12-06T23:59:59+05:30\"}};\nconst b = $in.body || {};\nconst bad = m => [{ json: { ok: false, status: 422, body: { success: false, message: m } } }];\nif (b.website) return bad('Please try again.');            // hidden field only bots fill in\nconst slug = String(b.event ?? '').toLowerCase();\nconst ev = EVENTS[slug];\nif (!ev) return [{ json: { ok: false, status: 404, body: { success: false, message: 'This form is not available.' } } }];\nif (ev.closes && new Date() > new Date(ev.closes)) return bad('Registration is closed.');\nconst name = String(b.name ?? '').trim().replace(/\\s+/g, ' ');\nif (name.length < 2 || name.length > 60 || !/^[\\p{L}][\\p{L} .'-]*$/u.test(name)) return bad('Enter your full name.');\nconst phone = String(b.phone ?? '').replace(/\\D/g, '').slice(-10);\nif (!/^[6-9]\\d{9}$/.test(phone)) return bad('Enter a valid 10-digit mobile number.');\nconst category = String(b.category ?? '').toUpperCase();\nif (!['BATSMAN', 'BOWLER', 'ALL_ROUNDER', 'WICKET_KEEPER'].includes(category)) return bad('Choose your category.');\nconst size = String(b.jersey_size ?? '').toUpperCase();\nif (!['XS', 'S', 'M', 'L', 'XL', 'XXL', '3XL'].includes(size)) return bad('Choose your jersey size.');\nconst jname = String(b.jersey_name ?? '').trim().toUpperCase().replace(/\\s+/g, ' ');\nif (!/^[A-Z][A-Z .'-]{0,11}$/.test(jname)) return bad('Jersey name must be 1-12 letters.');\nconst jno = Number(b.jersey_number);\nif (!(Number.isInteger(jno) && jno >= 0 && jno <= 99) || String(b.jersey_number ?? '').trim() === '') return bad('Jersey number must be 0 to 99.');\nconst food = String(b.food ?? '').toUpperCase();\nif (!['VEG', 'NON_VEG'].includes(food)) return bad('Choose veg or non-veg.');\nconst bin = $input.first().binary || {};\nconst exts = { 'image/jpeg': 'jpg', 'image/jpg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/heic': 'heic' };\nconst files = {};\nfor (const [k, label] of [['photo', 'profile photo'], ['payment', 'payment screenshot']]) {\n  const f = bin[k];\n  if (!f) return bad(`Add your ${label}.`);\n  const mime = f.mimeType === 'image/jpg' ? 'image/jpeg' : f.mimeType;\n  if (!exts[mime]) return bad(`The ${label} must be a photo (JPG or PNG).`);\n  const bytes = await byteSize(k, f);\n  if (bytes > 8 * 1024 * 1024) return bad(`The ${label} must be under 8 MB.`);\n  files[k] = { mime, key: `event_registrations/${slug}/${phone}_${k}_${Date.now()}.${exts[mime]}` };\n}\nreturn [{ json: { ok: true, slug, name, phone, category, size, jname, jno, food, files }, binary: bin }];"
      }
    },
