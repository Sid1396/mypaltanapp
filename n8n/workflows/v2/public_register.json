        "jsCode": "const $in = $input.first().json;\n\nconst msg = String($in.message || $in.error?.message || '');\nif (msg.includes('Duplicate') || msg.includes('uq_event_phone')) return [{ json: { status: 409, body: { success: false, message: 'This mobile number is already registered. Contact the organiser to change your details.' } } }];\nif (msg) return [{ json: { status: 500, body: { success: false, message: 'Could not save your registration. Please try again.' } } }];\nconst r = $('Check Request').first().json;\nreturn [{ json: { status: 200, body: { success: true, message: `Thanks ${r.name.split(' ')[0]}, you're registered.` } } }];"
