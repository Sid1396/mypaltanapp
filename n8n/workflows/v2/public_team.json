      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id, t.code, t.sport, t.name, t.short_name, t.logo_key, t.area, t.city, cap.name AS captain_name, (SELECT m.role FROM team_members m WHERE m.team_id = t.id AND m.user_id = cap.id AND m.status = 'ACTIVE') AS manager_role, (SELECT COUNT(*) FROM team_members m WHERE m.team_id = t.id AND m.status = 'ACTIVE' AND m.role <> 'COACH') AS members FROM teams t JOIN app_users cap ON cap.id = t.captain_user_id WHERE t.code = $1",
