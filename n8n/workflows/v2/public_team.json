      "parameters": {
        "jsCode": "\nconst b2 = $('Authorize B2').isExecuted ? $('Authorize B2').first().json : {};\nconst dl = b2?.apiInfo?.storageApi?.downloadUrl;\nconst tokenOf = node => { try { return $(node).isExecuted ? $(node).first().json.authorizationToken : null; } catch { return null; } };\nconst signWith = (key, node) => { const t = tokenOf(node); return key && dl && t ? `${dl}/file/mypaltan-profile-photos/${key.split('/').map(encodeURIComponent).join('/')}?Authorization=${t}` : null; };\nconst parseJ = v => { if (v === null || v === undefined) return null; if (typeof v === 'object') return v; try { return JSON.parse(v); } catch { return null; } };\n\nconst t = $('Load Team').first().json;\nreturn [{ json: { status: 200, body: { success: true, team: { code: t.code, sport: t.sport, name: t.name, short_name: t.short_name,\n  logo_url: signWith(t.logo_key, 'Assets Link'), area: t.area, city: t.city, captain_name: t.captain_name, manager_role: t.manager_role || 'CAPTAIN',\n  members: Number(t.members || 0) } } } }];"
      }
