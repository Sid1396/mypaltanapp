    },
    {
      "id": "b3aeb40d-b91a-4dcc-8373-799146887b3d",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "\nconst rows = $('Load Tournaments').all().map(i => i.json).filter(r => r && r._set);\nconst b2 = $('Authorize B2').isExecuted ? $('Authorize B2').first().json : {};\nconst link = $('Logo Link').isExecuted ? $('Logo Link').first().json : {};\nconst dl = b2?.apiInfo?.storageApi?.downloadUrl;\nconst signed = key => (key && dl && link?.authorizationToken)\n  ? `${dl}/file/mypaltan-profile-photos/${key.split('/').map(encodeURIComponent).join('/')}?Authorization=${link.authorizationToken}`\n  : null;\nconst parseTags = t => { if (Array.isArray(t)) return t; try { return JSON.parse(t || '[]'); } catch { return []; } };\nconst tournaments = rows.filter(r => r._set === 'tournament').map(r => ({\n  slug: r.slug, name: r.name, sport: r.sport, logo_url: signed(r.logo_key) || r.logo_url || null, start_date: r.start_date || null,\n  area: r.area || null, city: r.city, tags: parseTags(r.tags), status: r.status,\n}));\nconst banners = rows.filter(r => r._set === 'banner').map(r => ({\n  id: r.id, title: r.title, subtitle: r.subtitle || null, badge: r.badge || null, image_url: signed(r.image_key) || r.image_url || null,\n  theme: r.theme, cta_label: r.cta_label || null, link_type: r.link_type, link_value: r.link_value || null,\n}));\nconst unreadRow = rows.find(r => r._set === 'unread');\n\nreturn [{ json: { status: 200, body: { success: true, featured_tournaments: tournaments } } }];"
      }
    },
    {
