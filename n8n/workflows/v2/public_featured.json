      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'tournament' AS _set, slug, name, sport, logo_url, logo_key, DATE_FORMAT(start_date, '%Y-%m-%d') AS start_date, area, city, tags, status FROM featured_tournaments WHERE is_active = 1 ORDER BY sort_order, id",
