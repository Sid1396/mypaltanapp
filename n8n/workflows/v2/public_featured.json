    {
      "id": "b69b549c-edfd-43e4-adf4-b4e50d8207f0",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "\nconst rows = $('Load Tournaments').all().map(i => i.json).filter(r => r && r._set);\nconst b2 = $('Authorize B2').isExecuted ? $('Authorize B2').first().json : {};\nconst tokenOf = node => { try { return $(node).isExecuted ? $(node).first().json.authorizationToken : null; } catch { return null; } };\nconst dl = b2?.apiInfo?.storageApi?.downloadUrl;\nconst signed = key => {\n  const t = key && tokenOf(key.startsWith('tournament_assets/') ? 'Assets Link' : 'Logo Link');\n  return key && dl && t ? `${dl}/file/mypaltan-profile-photos/${key.split('/').map(encodeURIComponent).join('/')}?Authorization=${t}` : null;\n};\nconst parseTags = t => { if (Array.isArray(t)) return t; try { return JSON.parse(t || '[]'); } catch { return []; } };\n// Approved public tournaments first (they can be joined now), then the featured leagues.\nconst tournaments = rows.filter(r => r._set === 'tournament').map(r => ({\n  slug: r.slug || null, code: r.code || null, name: r.name, sport: r.sport, logo_url: signed(r.logo_key) || r.logo_url || null, start_date: r.start_date || null,\n  area: r.area || null, city: r.city, tags: parseTags(r.tags), status: r.status,\n}));\nconst banners = rows.filter(r => r._set === 'banner').map(r => ({\n  id: r.id, title: r.title, subtitle: r.subtitle || null, badge: r.badge || null, image_url: signed(r.image_key) || r.image_url || null,\n  theme: r.theme, cta_label: r.cta_label || null, link_type: r.link_type, link_value: r.link_value || null,\n}));\nconst unreadRow = rows.find(r => r._set === 'unread');\n\nreturn [{ json: { status: 200, body: { success: true, featured_tournaments: tournaments } } }];"
      }
    },
