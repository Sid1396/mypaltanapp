      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'tournament' AS _set, NULL AS slug, t.code, t.name, t.sport, NULL AS logo_url, t.logo_key, DATE_FORMAT(t.start_date, '%Y-%m-%d') AS start_date, t.area, t.city, JSON_ARRAY(CASE t.format WHEN 'LEAGUE' THEN 'League' WHEN 'KNOCKOUT' THEN 'Knockout' ELSE 'Groups + knockout' END, IF(t.entry_fee > 0, CONCAT('Entry \u20b9', FORMAT(t.entry_fee, 0, 'en_IN')), 'Free entry')) AS tags, t.status FROM tournaments t WHERE t.visibility = 'PUBLIC' AND t.status IN ('REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'FIXTURES_READY', 'LIVE') AND t.end_date >= CURDATE() ORDER BY t.start_date LIMIT 20; SELECT 'tournament' AS _set, slug, NULL AS code, name, sport, logo_url, logo_key, DATE_FORMAT(start_date, '%Y-%m-%d') AS start_date, area, city, tags, status FROM featured_tournaments WHERE is_active = 1 ORDER BY sort_order, id",
        "options": {
          "queryReplacement": ""
        }
      },
      "credentials": {
        "mySql": {
          "id": "cJO42PjVTTGgCHL1",
          "name": "MyPaltanDB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "2643835f-8658-4342-8a1e-17b2905cb9ec",
