    },
    {
      "id": "a8d1eaa3-b6e1-4d42-a6ee-5b6202e5348c",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst name = String(b.name || '').trim().slice(0, 100);\nconst phone = String(b.phone || '').replace(/\\D/g, '');\nconst city = String(b.city || '').trim().slice(0, 100);\nconst role = String(b.role || '').trim();\nconst ROLES = ['Player', 'Captain', 'Organizer', 'League / corporate'];\n// Where the signup came from: the landing page, or a tournament invite page (\"invite:ABC123\").\nconst rawSource = String(b.source || 'website').trim();\nconst source = /^(website|invite:[A-Z0-9]{6})$/.test(rawSource) ? rawSource : 'website';\n\nlet error = '';\nif (name.length < 2) error = 'Please enter your name.';\nelse if (!/^[6-9]\\d{9}$/.test(phone)) error = 'Please enter a valid 10-digit mobile number.';\nelse if (city.length < 2) error = 'Please enter your city.';\nelse if (!ROLES.includes(role)) error = 'Please choose who you are.';\n\nconst submittedAt = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' });\nreturn [{ json: { valid: !error, error, name, phone, city, role, source, submittedAt } }];"
      }
    },
    {
      "id": "d03eee0e-75ef-48e7-8ad5-e79ebea2f4e9",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
