        "subject": "=New early access sign-up: {{ $('Validate Input').first().json.name }} ({{ $('Validate Input').first().json.role }}, {{ $('Validate Input').first().json.city }})",
        "emailType": "text",
        "message": "=New early access sign-up on mypaltan.com\n\nName: {{ $('Validate Input').first().json.name }}\nMobile: +91 {{ $('Validate Input').first().json.phone }}\nCity: {{ $('Validate Input').first().json.city }}\nRole: {{ $('Validate Input').first().json.role }}\nFrom: {{ $('Validate Input').first().json.source }}\nSubmitted: {{ $('Validate Input').first().json.submittedAt }} IST\n\nWhatsApp: https://wa.me/91{{ $('Validate Input').first().json.phone }}",
        "options": {
          "appendAttribution": false
        }
